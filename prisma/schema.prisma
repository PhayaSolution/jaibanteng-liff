// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  ACTIVE
  DONE
  BACK
}

enum ReminderStatus {
  ACTIVE
  DONE
}

enum DeliveryStatus {
  SENT
  FAILED
}

model User {
  id              String   @id @default(uuid())
  lineUserId      String   @unique
  displayName     String
  pictureUrl      String?
  email           String?
  phoneNumber     String?
  reminderEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categories          Category[]
  tags                Tag[]
  transactions        Transaction[]
  reminders           Reminder[]
  reminderDeliveries  ReminderDelivery[]

  @@map("users")
}

model Category {
  id        String          @id @default(uuid())
  userId    String
  name      String
  type      TransactionType @default(EXPENSE)
  emoji     String?
  budget    Decimal?        @db.Decimal(10, 2)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("categories")
  @@index([userId])
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@map("tags")
  @@index([userId])
}

model Transaction {
  id         String            @id @default(uuid())
  userId     String
  type       TransactionType
  amount     Decimal           @db.Decimal(10, 2)
  date       DateTime
  name       String
  categoryId String?
  status     TransactionStatus @default(ACTIVE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     TransactionTag[]

  @@map("transactions")
  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, status])
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
  @@index([transactionId])
  @@index([tagId])
}

model ParseMessage {
  id        String          @id @default(uuid())
  keyword   String          @unique
  type      TransactionType
  category  String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("parse_messages")
  @@index([keyword])
  @@index([type])
  @@index([category])
}

model Reminder {
  id        String         @id @default(uuid())
  userId    String
  title     String
  note      String?
  remindAt  DateTime
  status    ReminderStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries ReminderDelivery[]

  @@map("reminders")
  @@index([userId])
  @@index([userId, remindAt])
  @@index([userId, status])
  @@index([status, remindAt])
}

model ReminderDelivery {
  id         String         @id @default(uuid())
  reminderId String
  userId     String
  sentFor    DateTime
  status     DeliveryStatus
  sentAt     DateTime       @default(now())
  error      String?

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reminderId, sentFor])
  @@map("reminder_deliveries")
  @@index([reminderId])
  @@index([userId])
  @@index([sentFor])
}